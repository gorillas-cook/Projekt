# Copy to .env for local development. Never commit .env; in production use your platform's secrets vault.

# Restricted API key (rk_test_...) with only the permissions listed in README.md
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the snapshot-event destination -> /webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Signing secret of the thin-event destination (v2 account events) -> /webhooks/stripe-v2
STRIPE_WEBHOOK_SECRET_V2=

APP_URL=http://localhost:4242
# Platform commission in basis points: 1000 = 10%
PLATFORM_FEE_BPS=1000
# Turn on only after Tax settings have a head office address AND at least one active registration
STRIPE_TAX_ENABLED=false
